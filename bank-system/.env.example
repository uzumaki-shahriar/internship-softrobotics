# Identity of this bank instance - change these per instance to simulate a
# different bank (e.g. copy this file, change BANK_NAME/BANK_CODE/PORT/
# DATABASE_URL, run it alongside this one).
BANK_NAME=Demo Bank
BANK_CODE=DEMO001
BANK_CURRENCY=BDT

PORT=8001
NODE_ENV=development
LOG_LEVEL=info

# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5442/bank_demo

# Shared secret the Payment Gateway must send as X-API-KEY on every call.
BANK_API_KEY=change-me

# Signs the admin session cookie.
SESSION_SECRET=change-me

# How long a customer has to enter the OTP on /otp/:reference before the
# challenge expires, and how many wrong guesses they get before it's a
# terminal decline.
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3

# Used only by prisma/seed.js to create the first admin login.
ADMIN_EMAIL=admin@bank.local
ADMIN_PASSWORD=admin123
