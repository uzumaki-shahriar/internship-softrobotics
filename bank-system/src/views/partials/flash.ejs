<% if (typeof success !== "undefined" && success.length) { %>
  <% success.forEach(function(msg) { %>
    <div class="flash flash-success"><%= msg %></div>
  <% }) %>
<% } %>
<% if (typeof errorFlash !== "undefined" && errorFlash.length) { %>
  <% errorFlash.forEach(function(msg) { %>
    <div class="flash flash-error"><%= msg %></div>
  <% }) %>
<% } %>
