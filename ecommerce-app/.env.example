APP_NAME=Bookworm Cafe
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce_shop

# The Payment Gateway this shop is a merchant of.
GATEWAY_BASE_URL=http://localhost:8000
GATEWAY_CURRENCY=BDT

# Used only once by src/bootstrap.js to self-register this shop as a
# merchant and get admin-approved. After that succeeds, the resulting API
# key lives in the ShopConfig table - these are never used again.
SHOP_OWNER_NAME=Bookworm Cafe Owner
SHOP_OWNER_EMAIL=owner@bookwormcafe.example
SHOP_OWNER_PASSWORD=change-me-not-used-day-to-day
SHOP_STORE_NAME=Bookworm Cafe
SHOP_COMMISSION_PERCENTAGE=2.5
SHOP_COMMISSION_FIXED=5

# Must match the Payment Gateway's own seeded admin (its ADMIN_EMAIL/
# ADMIN_PASSWORD) - needed to self-approve on first boot.
GATEWAY_ADMIN_EMAIL=admin@gateway.local
GATEWAY_ADMIN_PASSWORD=admin123
