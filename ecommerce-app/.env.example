APP_NAME=Bookworm Cafe
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce_shop

# The Payment Gateway this shop is a merchant of.
GATEWAY_BASE_URL=http://localhost:8000
GATEWAY_CURRENCY=BDT

# This shop's merchant API key. There is no automated registration in this
# app - the 3 systems are separate, independently-run businesses in this
# simulation, so nothing here is allowed to log into the Gateway on the
# shop's behalf. Get a real one the same way a real merchant would:
#   1. POST /api/merchant/register on the Payment Gateway (or use its
#      dashboard signup, once one exists) with this shop's own details.
#   2. Wait for the Gateway's admin to review and approve the account
#      (POST /api/admin/merchants/:id/approve, or via its admin panel).
#   3. Paste the api_key you were given below.
# See the repo root README's "Provisioning a merchant" section.
GATEWAY_API_KEY=sk_test_replace-with-your-approved-merchant-key
