{
  "name": "ecommerce-app",
  "version": "1.0.0",
  "private": true,
  "description": "A tiny 2-product shop that pays via the Payment Gateway. Never touches card data - just redirects to the Gateway's hosted checkout and verifies server-side afterward.",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "express-ejs-layouts": "^2.5.1",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0"
  }
}
