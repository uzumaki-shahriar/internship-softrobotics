APP_NAME=Payment Gateway
PORT=8000
NODE_ENV=development
LOG_LEVEL=info

# postgresql://<user>:<password>@<host>:<port>/<database>
# Points at the shared Postgres from the repo root's docker-compose.yml
# (run `docker compose up -d postgres` from the repo root first if you're
# running this app locally with `npm run dev` instead of fully in Docker).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/payment_gateway

# Signs merchant/admin JWTs.
JWT_SECRET=change-me
# Reserved for later admin-session use (Milestone 5).
SESSION_SECRET=change-me

# The Bank System this Gateway talks to, server-to-server.
BANK_API_BASE_URL=http://localhost:8001
BANK_API_KEY=dev-bank-api-key

# How long a checkout session stays payable before it expires.
CHECKOUT_SESSION_TTL_MINUTES=5

# Used only by prisma/seed.js to create the first admin login.
ADMIN_EMAIL=admin@gateway.local
ADMIN_PASSWORD=admin123
