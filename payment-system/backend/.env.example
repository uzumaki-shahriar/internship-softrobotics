APP_NAME=Payment Gateway
DEBUG=true
LOG_LEVEL=DEBUG

# postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://gateway_user:gateway_pass@localhost:5432/softrobo_payment_gateway

# JWT — generate a strong random secret, e.g: openssl rand -hex 32
JWT_SECRET=change_me_to_a_strong_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Static API key for internal/admin server-to-server calls (X-API-KEY header)
# Share this value with Module 1 (Bank System) and any trusted internal callers
GATEWAY_API_KEY=gw_internal_secret_key
