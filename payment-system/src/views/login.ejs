<div class="auth-box">
  <h1><%= appName %></h1>
  <p class="muted">Sign in</p>
  <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>
  <form method="post" action="/login" id="login-form" novalidate>
    <label>Email
      <input type="email" name="email" required autofocus />
    </label>
    <label>Password
      <input type="password" name="password" required />
    </label>
    <button type="submit">Sign in</button>
  </form>
  <p class="muted" style="margin-top:16px">
    No merchant account yet? <a href="/dashboard/register">Create a merchant account</a>.
  </p>

  <div class="demo-accounts">
    <h2>Demo accounts</h2>
    <div class="demo-account-list">
      <form method="post" action="/login">
        <input type="hidden" name="email" value="admin@gateway.local" />
        <input type="hidden" name="password" value="admin123" />
        <button type="submit" class="demo-account-btn">
          <span class="demo-account-icon">🛡️</span>
          <span class="demo-account-label">Admin</span>
          <span class="demo-account-role muted">Platform admin</span>
        </button>
      </form>
      <form method="post" action="/login">
        <input type="hidden" name="email" value="owner@bookwormcafe.example" />
        <input type="hidden" name="password" value="password123" />
        <button type="submit" class="demo-account-btn">
          <span class="demo-account-icon">📚</span>
          <span class="demo-account-label">Bookworm Cafe</span>
          <span class="demo-account-role muted">Merchant dashboard</span>
        </button>
      </form>
    </div>
  </div>
</div>
<script src="/js/validation.js"></script>
