<div class="auth-box">
  <h1><%= appName %></h1>
  <p class="muted">Merchant sign in</p>
  <% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>
  <form method="post" action="/dashboard/login" id="login-form" novalidate>
    <label>Email
      <input type="email" name="email" required autofocus />
    </label>
    <label>Password
      <input type="password" name="password" required />
    </label>
    <button type="submit">Sign in</button>
  </form>
  <p class="muted" style="margin-top:16px">
    No account yet? Register via <code>POST /api/merchant/register</code> - see <code>payment-system/README.md</code>.
  </p>
</div>
<script src="/js/validation.js"></script>
