<h1><%= merchant.name %></h1>
<p class="muted">
  <%= merchant.storeId %> · <span class="badge badge-<%= merchant.status %>"><%= merchant.status %></span>
</p>

<% if (merchant.status === "pending") { %>
  <div class="flash flash-error">
    Your account is pending admin approval. You have an API key, but checkout/charge
    requests will be rejected until an admin sets your commission and activates you.
  </div>
<% } else if (merchant.status === "suspended") { %>
  <div class="flash flash-error">
    Your account has been suspended by an admin. Contact support to be reactivated.
  </div>
<% } %>

<div class="stat-grid">
  <% if (wallets.length === 0) { %>
    <div class="stat-card">
      <div class="stat-value">-</div>
      <div class="stat-label">No wallet yet</div>
    </div>
  <% } else { %>
    <% wallets.forEach(function(w) {
         const total = (Number(w.balance) + Number(w.blockedAmount) + Number(w.rollingAmount)).toFixed(2);
    %>
      <div class="stat-card">
        <div class="stat-value"><%= w.currency.code %> <%= total %></div>
        <div class="stat-label">Total balance</div>
      </div>
      <div class="stat-card">
        <div class="stat-value"><%= w.currency.code %> <%= w.balance %></div>
        <div class="stat-label">Available</div>
      </div>
      <div class="stat-card">
        <div class="stat-value"><%= w.currency.code %> <%= w.rollingAmount %></div>
        <div class="stat-label">Rolling reserve</div>
      </div>
    <% }) %>
  <% } %>
  <div class="stat-card">
    <div class="stat-value"><%= todayCount %></div>
    <div class="stat-label">Transactions today</div>
  </div>
</div>

<% if (wallets.length > 0) { %>
  <h2>Deposit from your bank account</h2>
  <% if (depositError) { %><div class="flash flash-error"><%= depositError %></div><% } %>
  <% if (!merchant.bankAccountNumber) { %>
    <p class="muted">Link a bank account in <a href="/dashboard/settings">Settings</a> before depositing.</p>
  <% } else { %>
    <% wallets.forEach(function(w) { %>
      <form method="post" action="/dashboard/overview/deposit" class="confirm-form" data-confirm="Deposit from your bank account?">
        <input type="hidden" name="currency" value="<%= w.currency.code %>" />
        <label><%= w.currency.code %> amount
          <input type="number" name="amount" step="0.01" min="0.01" required />
        </label>
        <button type="submit">Deposit</button>
      </form>
    <% }) %>
  <% } %>

  <h2>Withdraw to your bank account</h2>
  <% if (withdrawError) { %><div class="flash flash-error"><%= withdrawError %></div><% } %>
  <% if (!merchant.bankAccountNumber) { %>
    <p class="muted">Link a bank account in <a href="/dashboard/settings">Settings</a> before withdrawing.</p>
  <% } else { %>
    <% wallets.forEach(function(w) { %>
      <form method="post" action="/dashboard/overview/withdraw" class="confirm-form" data-confirm="Withdraw to your bank account?">
        <input type="hidden" name="currency" value="<%= w.currency.code %>" />
        <label><%= w.currency.code %> amount (available: <%= w.balance %>)
          <input type="number" name="amount" step="0.01" min="0.01" max="<%= w.balance %>" required />
        </label>
        <button type="submit">Withdraw</button>
      </form>
    <% }) %>
  <% } %>
<% } %>

<h2>Your rate</h2>
<% if (merchant.pricingPlans.length === 0) { %>
  <p class="muted">No pricing plan set yet - an admin sets this when approving your account.</p>
<% } else { %>
  <table>
    <thead><tr><th>Currency</th><th>Commission</th><th>Settlement</th></tr></thead>
    <tbody>
      <% merchant.pricingPlans.forEach(function(p) { %>
        <tr>
          <td><%= p.currency.code %></td>
          <td><%= p.commissionPercentage %>% + <%= p.commissionFixed %></td>
          <td><%= p.settlementDay %> days</td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<h2>Recent transactions</h2>
<% if (recentTransactions.length === 0) { %>
  <p class="muted">No transactions yet.</p>
<% } else { %>
  <table>
    <thead><tr><th>When</th><th>Invoice</th><th>Status</th><th>Amount</th></tr></thead>
    <tbody>
      <% recentTransactions.forEach(function(t) { %>
        <tr>
          <td><%= t.createdAt.toISOString() %></td>
          <td><a href="/dashboard/transactions/<%= t.invoiceId %>"><%= t.invoiceId %></a></td>
          <td><span class="badge badge-<%= t.status %>"><%= t.status %></span></td>
          <td><%= t.grossAmount %> <%= t.currency.code %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>
<p><a href="/dashboard/transactions">View all transactions</a></p>
