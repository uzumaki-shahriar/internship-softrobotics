<h1><%= merchant.name %></h1>
<p class="muted">
  <%= merchant.storeId %> · <%= merchant.address || "no address on file" %> ·
  <span class="badge badge-<%= merchant.status %>"><%= merchant.status %></span> ·
  key <%= merchant.apiKeyPrefix %>... ·
  bank account <%= merchant.bankAccountNumber || "not linked" %>
</p>

<div class="actions">
  <a href="/admin/merchants/<%= merchant.id %>/edit"><button type="button">Edit</button></a>
  <% if (merchant.status !== "suspended") { %>
    <form method="post" action="/admin/merchants/<%= merchant.id %>/suspend" class="confirm-form" data-confirm="Suspend this merchant? They will not be able to process payments.">
      <button type="submit" class="danger">Suspend</button>
    </form>
  <% } else { %>
    <form method="post" action="/admin/merchants/<%= merchant.id %>/reactivate">
      <button type="submit">Reactivate</button>
    </form>
  <% } %>
</div>

<h2>Wallets</h2>
<% if (merchant.wallets.length === 0) { %>
  <p class="muted">No wallet yet - approve the merchant for a currency below.</p>
<% } else { %>
  <% merchant.wallets.forEach(function(w) {
       const total = (Number(w.balance) + Number(w.blockedAmount) + Number(w.rollingAmount)).toFixed(2);
  %>
    <h3><%= w.currency.code %></h3>
    <div class="stat-grid">
      <div class="stat-card">
        <div class="stat-value"><%= w.currency.code %> <%= total %></div>
        <div class="stat-label">Total (all-time captured)</div>
      </div>
      <div class="stat-card">
        <div class="stat-value"><%= w.currency.code %> <%= w.balance %></div>
        <div class="stat-label">Available (withdrawable now)</div>
      </div>
      <div class="stat-card">
        <div class="stat-value"><%= w.currency.code %> <%= w.blockedAmount %></div>
        <div class="stat-label">Not settled (pending settlement)</div>
      </div>
      <div class="stat-card">
        <div class="stat-value"><%= w.currency.code %> <%= w.rollingAmount %></div>
        <div class="stat-label">Rolling reserve</div>
      </div>
    </div>
  <% }) %>
  <p class="muted">Available excludes the not-settled and rolling-reserve amounts - those move into Available only once their own settlement/rolling job releases them.</p>
<% } %>

<h2>POS</h2>
<% if (error) { %><div class="flash flash-error"><%= error %></div><% } %>
<% const pos = merchant.pricingPlans[0]; %>
<form method="post" action="/admin/merchants/<%= merchant.id %>/approve" novalidate>
  <table>
    <tbody>
      <tr>
        <td class="muted">Currency</td>
        <td>
          <% if (pos) { %>
            <%= pos.currency.code %> - <%= pos.currency.name %>
            <input type="hidden" name="currency" value="<%= pos.currency.code %>" />
          <% } else { %>
            <select name="currency" required>
              <% currencies.forEach(function(c) { %>
                <option value="<%= c.code %>"><%= c.code %> - <%= c.name %></option>
              <% }) %>
            </select>
          <% } %>
        </td>
      </tr>
      <tr>
        <td class="muted">Commission percentage</td>
        <td><input type="number" name="commission_percentage" step="0.01" min="0" max="100" value="<%= pos ? pos.commissionPercentage : '2.00' %>" required /></td>
      </tr>
      <tr>
        <td class="muted">Fixed fee</td>
        <td><input type="number" name="commission_fixed" step="0.01" min="0" value="<%= pos ? pos.commissionFixed : '5.00' %>" required /></td>
      </tr>
      <tr>
        <td class="muted">Settlement (days)</td>
        <td><input type="number" name="settlement_day" min="0" value="<%= pos ? pos.settlementDay : '3' %>" required /></td>
      </tr>
      <tr>
        <td class="muted">Rolling percentage</td>
        <td><input type="number" name="rolling_percentage" step="0.01" min="0" max="100" value="<%= pos ? pos.rollingPercentage : '0' %>" required /></td>
      </tr>
      <tr>
        <td class="muted">Rolling period</td>
        <td>
          <select name="rolling_period" required>
            <option value="weekly" <%= pos && pos.rollingPeriod === "weekly" ? "selected" : "" %>>Weekly</option>
            <option value="monthly" <%= !pos || pos.rollingPeriod !== "weekly" ? "selected" : "" %>>Monthly</option>
          </select>
        </td>
      </tr>
    </tbody>
  </table>
  <button type="submit">Save</button>
</form>
<script src="/js/validation.js"></script>

<h2>Recent transactions</h2>
<table>
  <thead><tr><th>When</th><th>Invoice</th><th>Status</th><th>Gross</th><th>Fee</th><th>Net</th></tr></thead>
  <tbody>
    <% transactions.forEach(function(t) { %>
      <tr>
        <td><%= t.createdAt.toISOString() %></td>
        <td><a href="/admin/transactions/<%= t.invoiceId %>"><%= t.invoiceId %></a></td>
        <td><span class="badge badge-<%= t.status %>"><%= t.status %></span></td>
        <td><%= t.grossAmount %> <%= t.currency.code %></td>
        <td><%= t.feeAmount %></td>
        <td><%= t.netAmount %></td>
      </tr>
    <% }) %>
  </tbody>
</table>
