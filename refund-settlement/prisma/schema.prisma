generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionState {
  Pending
  Completed
  PartialRefunded
  Refunded
  Failed
}

enum RefundStatus {
  Pending
  Completed
  Failed
}

enum SettlementStatus {
  Pending
  Completed
  Failed
}

enum SettlementCycle {
  Daily
  Weekly
  Monthly
}

enum RollingPeriod {
  Weekly
  Monthly
}

model Merchant {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  wallets           Wallet[]
  transactions      Transaction[]
  settlements       Settlement[]
  settlementConfig  MerchantSettlementConfig?

  @@map("merchants")
}

model Currency {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String

  wallets      Wallet[]
  transactions Transaction[]

  @@map("currencies")
}

model Pos {
  id   Int    @id @default(autoincrement())
  name String

  transactions Transaction[]

  @@map("pos")
}

model Wallet {
  id               Int      @id @default(autoincrement())
  merchantId       Int      @map("merchant_id")
  currencyId       Int      @map("currency_id")
  totalBalance     Decimal  @default(0) @map("total_balance") @db.Decimal(18, 2)
  availableBalance Decimal  @default(0) @map("available_balance") @db.Decimal(18, 2)
  blockedBalance   Decimal  @default(0) @map("blocked_balance") @db.Decimal(18, 2)
  rollingBalance   Decimal  @default(0) @map("rolling_balance") @db.Decimal(18, 2)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  merchant    Merchant     @relation(fields: [merchantId], references: [id])
  currency    Currency     @relation(fields: [currencyId], references: [id])
  settlements Settlement[]

  @@unique([merchantId, currencyId])
  @@map("wallets")
}

model Transaction {
  id              Int               @id @default(autoincrement())
  invoiceId       String            @map("invoice_id")
  orderId         String            @map("order_id")
  merchantId      Int               @map("merchant_id")
  posId           Int               @map("pos_id")
  currencyId      Int               @map("currency_id")
  gross           Decimal           @db.Decimal(18, 2)
  fee             Decimal           @default(0) @db.Decimal(18, 2)
  net             Decimal           @db.Decimal(18, 2)
  refundedAmount  Decimal           @default(0) @map("refunded_amount") @db.Decimal(18, 2)
  settledAmount   Decimal           @default(0) @map("settled_amount") @db.Decimal(18, 2)
  rollingAmount     Decimal   @default(0) @map("rolling_amount") @db.Decimal(18, 2)
  rollingReleaseAt  DateTime? @map("rolling_release_at")
  rollingReleasedAt DateTime? @map("rolling_released_at")
  transactionState TransactionState @default(Pending) @map("transaction_state")
  settlementDate  DateTime?         @map("settlement_date")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  completedAt     DateTime?         @map("completed_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])
  pos      Pos      @relation(fields: [posId], references: [id])
  currency Currency @relation(fields: [currencyId], references: [id])
  refunds  Refund[]

  @@map("transactions")
}

model Refund {
  id            Int          @id @default(autoincrement())
  transactionId Int          @map("transaction_id")
  amount        Decimal      @db.Decimal(18, 2)
  status        RefundStatus @default(Pending)
  createdAt     DateTime     @default(now()) @map("created_at")
  completedAt   DateTime?    @map("completed_at")

  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@map("refunds")
}

model Settlement {
  id          Int              @id @default(autoincrement())
  merchantId  Int              @map("merchant_id")
  walletId    Int              @map("wallet_id")
  amount      Decimal          @db.Decimal(18, 2)
  status      SettlementStatus @default(Pending)
  createdAt   DateTime         @default(now()) @map("created_at")
  completedAt DateTime?        @map("completed_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])
  wallet   Wallet   @relation(fields: [walletId], references: [id])

  @@map("settlements")
}

model MerchantSettlementConfig {
  id                Int             @id @default(autoincrement())
  merchantId        Int             @unique @map("merchant_id")
  settlementCycle   SettlementCycle @default(Daily) @map("settlement_cycle")
  settlementTime    String          @map("settlement_time")
  rollingPercentage Decimal         @default(0) @map("rolling_percentage") @db.Decimal(5, 2)
  rollingPeriod     RollingPeriod   @default(Monthly) @map("rolling_period")
  lastSettledAt     DateTime?       @map("last_settled_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@map("merchant_settlement_configs")
}
