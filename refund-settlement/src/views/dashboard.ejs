<%- include('partials/head') %>

<h1>PSP Dashboard</h1>

<div class="stat-row">
  <div class="stat-card">
    <div class="stat-label">Merchants</div>
    <div class="stat-value"><%= merchantCount %></div>
  </div>
  <div class="stat-card">
    <div class="stat-label">Transactions</div>
    <div class="stat-value"><%= transactionCount %></div>
  </div>
  <% Object.keys(totalsByCurrency).forEach(function(code) { %>
    <div class="stat-card">
      <div class="stat-label">Total Balance (<%= code %>)</div>
      <div class="stat-value"><%= totalsByCurrency[code].toFixed(2) %></div>
    </div>
  <% }); %>
</div>

<h2>Merchants</h2>
<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Transactions</th>
      <th>Wallet Total</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% merchants.forEach(function(m) { %>
      <tr>
        <td><%= m.name %></td>
        <td><%= m._count.transactions %></td>
        <td>
          <% m.wallets.forEach(function(w) { %>
            <%= w.currency.code %> <%= w.totalBalance %><br />
          <% }); %>
        </td>
        <td><a href="/merchants/<%= m.id %>/dashboard">View Dashboard</a></td>
      </tr>
    <% }); %>
  </tbody>
</table>

<h2>Recent Transactions</h2>
<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Merchant</th>
      <th>Order</th>
      <th>Net</th>
      <th>Status</th>
    </tr>
  </thead>
  <tbody>
    <% recentTransactions.forEach(function(t) { %>
      <tr onclick="window.location='/transactions/<%= t.id %>'">
        <td><%= t.id %></td>
        <td><%= t.merchant.name %></td>
        <td><%= t.orderId %></td>
        <td><%= t.net %></td>
        <td><%= t.transactionState %></td>
      </tr>
    <% }); %>
  </tbody>
</table>

<%- include('partials/foot') %>
