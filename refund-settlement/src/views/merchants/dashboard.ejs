<%- include('../partials/head') %>

<h1><%= merchant.name %> — Dashboard</h1>

<div class="stat-row">
  <div class="stat-card">
    <div class="stat-label">Transactions</div>
    <div class="stat-value"><%= transactionCount %></div>
  </div>
  <% wallets.forEach(function(w) { %>
    <div class="stat-card">
      <div class="stat-label">Total (<%= w.currency.code %>)</div>
      <div class="stat-value"><%= w.totalBalance %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Available (<%= w.currency.code %>)</div>
      <div class="stat-value"><%= w.availableBalance %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Blocked (<%= w.currency.code %>)</div>
      <div class="stat-value"><%= w.blockedBalance %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Rolling (<%= w.currency.code %>)</div>
      <div class="stat-value"><%= w.rollingBalance %></div>
    </div>
  <% }); %>
</div>

<div class="actions-row">
  <a href="/transactions/new?merchant_id=<%= merchant.id %>" class="btn">New Transaction</a>
  <a href="/merchants/<%= merchant.id %>/wallet" class="btn">View Wallet</a>
  <a href="/merchants/<%= merchant.id %>/settlement-config" class="btn">Settlement Config</a>
</div>

<h2>Settlement Configuration</h2>
<% if (config) { %>
  <table class="details">
    <tr><td>Cycle</td><td><%= config.settlementCycle %></td></tr>
    <tr><td>Time</td><td><%= config.settlementTime %></td></tr>
    <tr><td>Rolling Percentage</td><td><%= config.rollingPercentage %>%</td></tr>
    <tr><td>Rolling Period</td><td><%= config.rollingPeriod %></td></tr>
  </table>
<% } else { %>
  <p>No settlement configuration yet. <a href="/merchants/<%= merchant.id %>/settlement-config">Set it up</a>.</p>
<% } %>

<h2>Recent Transactions</h2>
<table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Order</th>
      <th>Net</th>
      <th>Status</th>
    </tr>
  </thead>
  <tbody>
    <% recentTransactions.forEach(function(t) { %>
      <tr onclick="window.location='/transactions/<%= t.id %>'">
        <td><%= t.id %></td>
        <td><%= t.orderId %></td>
        <td><%= t.net %></td>
        <td><%= t.transactionState %></td>
      </tr>
    <% }); %>
  </tbody>
</table>

<%- include('../partials/foot') %>
