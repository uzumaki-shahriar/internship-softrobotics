<%- include('../partials/head') %>

<h1>Transaction #<%= transaction.id %></h1>

<table class="details">
  <tr><td>Order ID</td><td><%= transaction.orderId %></td></tr>
  <tr><td>Invoice ID</td><td><%= transaction.invoiceId %></td></tr>
  <tr><td>Gross</td><td><%= transaction.gross %></td></tr>
  <tr><td>Fee</td><td><%= transaction.fee %></td></tr>
  <tr><td>Net</td><td><%= transaction.net %></td></tr>
  <tr><td>Refunded</td><td><%= transaction.refundedAmount %></td></tr>
  <tr><td>Refundable</td><td><%= Number(transaction.gross) - Number(transaction.refundedAmount) %></td></tr>
  <tr><td>Status</td><td><%= transaction.transactionState %></td></tr>
  <% if (Number(transaction.settledAmount) > 0) { %>
    <tr><td>Settlement Amount</td><td><%= transaction.settledAmount %></td></tr>
    <tr>
      <td>Settlement Status</td>
      <td>
        <% if (transaction.settledAt) { %>
          Settled on <%= transaction.settledAt.toDateString() %>
        <% } else { %>
          Blocked until <%= transaction.settlementDate.toDateString() %>
        <% } %>
      </td>
    </tr>
  <% } %>
  <% if (Number(transaction.rollingAmount) > 0) { %>
    <tr><td>Rolling Reserve</td><td><%= transaction.rollingAmount %></td></tr>
    <tr>
      <td>Rolling Status</td>
      <td>
        <% if (transaction.rollingReleasedAt) { %>
          Released on <%= transaction.rollingReleasedAt.toDateString() %>
        <% } else { %>
          Held until <%= transaction.rollingReleaseAt.toDateString() %>
        <% } %>
      </td>
    </tr>
  <% } %>
</table>

<% if (["Completed", "PartialRefunded"].includes(transaction.transactionState)) { %>
  <h2>Refund</h2>
  <form method="POST" action="/transactions/<%= transaction.id %>/refund">
    <label>Refund Amount</label>
    <input type="number" step="0.01" name="amount" required />
    <button type="submit" class="btn">Refund</button>
  </form>
<% } %>

<h2>Refund History</h2>
<table>
  <thead>
    <tr><th>ID</th><th>Amount</th><th>Status</th></tr>
  </thead>
  <tbody>
    <% transaction.refunds.forEach(function(r) { %>
      <tr>
        <td><%= r.id %></td>
        <td><%= r.amount %></td>
        <td><%= r.status %></td>
      </tr>
    <% }); %>
  </tbody>
</table>

<%- include('../partials/foot') %>
