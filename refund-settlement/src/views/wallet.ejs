<%- include('partials/head') %>

<h1>Merchant Wallet — <%= merchant.name %></h1>

<table>
  <thead>
    <tr>
      <th>Currency</th>
      <th>Total Balance</th>
      <th>Available Balance</th>
      <th>Blocked Balance</th>
      <th>Rolling Balance</th>
    </tr>
  </thead>
  <tbody>
    <% wallets.forEach(function(w) { %>
      <tr>
        <td><%= w.currency.code %></td>
        <td><%= w.totalBalance %></td>
        <td><%= w.availableBalance %></td>
        <td><%= w.blockedBalance %></td>
        <td><%= w.rollingBalance %></td>
      </tr>
    <% }); %>
  </tbody>
</table>

<%- include('partials/foot') %>
